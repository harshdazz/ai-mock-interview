# Copy to .env and fill in. Never commit .env — it is gitignored.

# Google Gemini — question generation + answer feedback
# aistudio.google.com/apikey  (free tier is sufficient)
VITE_GEMINI_API_KEY=

# Firebase — authentication and Firestore.
# Enable Email/Password and Google under Authentication > Sign-in method,
# and create a Firestore database. Then publish firestore.rules.
# console.firebase.google.com > project settings > your web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
