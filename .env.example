# Copy to .env and fill in. Never commit .env — it is gitignored.

# Google Gemini — question generation, CV reading and answer grading.
# aistudio.google.com/apikey  (free tier is sufficient)
# Server-side only: `pnpm dev:api` and `pnpm eval` read it from here, and in
# production it is a Worker secret (pnpm exec wrangler secret put GEMINI_API_KEY).
# Never rename it to VITE_…: Vite compiles every VITE_ variable into the public
# JS bundle, and the build refuses to run while VITE_GEMINI_API_KEY exists.
GEMINI_API_KEY=

# Where the browser sends AI requests. `pnpm dev:api` serves the worker here;
# for production, use the workers.dev URL that `pnpm run deploy:api` prints.
VITE_AI_API_URL=http://localhost:8787

# Firebase — authentication and Firestore.
# Enable Email/Password and Google under Authentication > Sign-in method,
# and create a Firestore database. Then publish firestore.rules.
# console.firebase.google.com > project settings > your web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
